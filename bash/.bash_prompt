PROMPT=">>"

RED="\[\033[1;31m\]"
GREEN="\[\033[1;32m\]"
YELLOW="\[\033[0;33m\]"
BLUE="\[\033[1;34m\]"
CYAN="\[\033[1;36m\]"
GRAY="\[\033[1;37m\]"
RESET="\[\033[0m\]"

get_cwd() {
    [[ $PWD == $HOME* ]] && echo "~${PWD#$HOME}" || echo "$PWD"
}

get_python_env() {
    if [ -n "$CONDA_DEFAULT_ENV" ]; then
        echo -ne "$CYAN($CONDA_DEFAULT_ENV)$RESET"
    elif [ -n "$VIRTUAL_ENV" ]; then
        name=$(basename "$VIRTUAL_ENV")
        if [[ "$name" =~ ^([a-zA-Z0-9._-]+)-[a-zA-Z0-9_-]+-(py[0-9.]+)$ ]]; then
            echo -ne "$CYAN(${BASH_REMATCH[1]}-${BASH_REMATCH[2]})$RESET"
        else
            echo -ne "$CYAN($name)$RESET"
        fi
    fi
}

# Fast prompt helper: single git call, parse branch/ahead/behind + staged/modified/untracked
get_git_branch() {
    # Bail if not in a git repo
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

    # One cheap call; add a tiny timeout to avoid lag on huge repos (optional)
    local out
    if command -v timeout >/dev/null 2>&1; then
        out=$(timeout 0.15 git status --porcelain=1 -b 2>/dev/null) || return
    else
        out=$(git status --porcelain=1 -b 2>/dev/null) || return
    fi

    local branch="" ahead=0 behind=0 staged=0 modified=0 untracked=0

    while IFS= read -r line; do
        case "$line" in
            "## "*)
                # Example: "## main...origin/main [ahead 1, behind 2]"
                branch=${line#\#\# }              # strip "## "
                branch=${branch%%...*}            # keep local branch before "..."
                [[ $line =~ ahead[[:space:]]+([0-9]+) ]]  && ahead=${BASH_REMATCH[1]}
                [[ $line =~ behind[[:space:]]+([0-9]+) ]] && behind=${BASH_REMATCH[1]}
                ;;
            "?? "*)
                ((untracked++))
                ;;
            *)
                # Porcelain v1: two status chars (index, worktree)
                [[ ${line:0:1} != " " ]] && ((staged++))
                [[ ${line:1:1} != " " ]] && ((modified++))
                ;;
        esac
    done <<< "$out"

    # Build badges like your original
    local added="" changed="" unk="" sync="" GIT_COLOR=$YELLOW
    ((staged>0))     && added="+$staged"
    ((modified>0))   && changed="!$modified"
    ((untracked>0))  && unk="?$untracked"
    ((ahead>0))      && sync+="⇡$ahead"
    ((behind>0))     && sync+="⇣$behind"

    # Color logic: green if ahead, add red if behind too
    ((ahead>0))  && GIT_COLOR=$GREEN
    ((behind>0)) && GIT_COLOR+=$RED

    local status="$sync $added $changed $unk"
    status=$(printf '%s\n' "$status" | xargs)   # trim

    printf ' (%s%s%s%s)\n' "$GIT_COLOR" "$branch" "${status:+ $status}" "$RESET"
}

get_terraform_workspace() {
    if command -v terraform >/dev/null 2>&1 && [ -d ".terraform" ]; then
        ws=$(terraform workspace show 2>/dev/null)
        [ -n "$ws" ] && echo -ne "$YELLOW[tf:$ws]$RESET"
    fi
}

fill_with_dots() {
  local prefix="$*"
  local clean=$(echo -ne "$prefix" | sed 's/\x1b\[[0-9;]*m//g')
  local clean=$(echo -ne "$clean" | sed 's/\\\[//g' | sed 's/\\\]//g')

  local width=$(tput cols)
  local len=$(echo -ne "$clean" | awk '{ print length }')
  local dots=$((width - len))

  [ $dots -gt 0 ] && printf "%*s" "$dots" '' | tr ' ' '-'
}

PROMPT_COMMAND='
    context="$GREEN$(whoami)@$(uname -n)$RESET"
    workdir="$BLUE$(get_cwd)$RESET"
    branch="$(get_git_branch)"

    venv="$(get_python_env)"
    tf_ws="$(get_terraform_workspace)"

    left_prompt="$context:$workdir$branch "
    right_prompt=" $venv$tf_ws"

    fill="$BLUE$(fill_with_dots "$left_prompt$right_prompt")$RESET"

    line1="$left_prompt$fill$right_prompt"
    line2="$BLUE$PROMPT$RESET"

    PS1="${line1}\n${line2} "
'
