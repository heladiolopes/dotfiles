[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 80
sql_file_exts = .sql,.sql.j2,.bql,.bql.j2
# exclude_rules = L034,L032

###############
# Indentation #
###############

[sqlfluff:indentation]
indented_joins = true
indented_using_on = true
indented_on_contents = false
indented_then = false
tab_space_size = 4
indent_unit = space

#########
# Rules #
#########

# Aliasing
[sqlfluff:rules:aliasing.length]
min_alias_length = 2
[sqlfluff:rules:aliasing.table]
aliasing = explicit
[sqlfluff:rules:aliasing.column]
aliasing = explicit

# Capitalisation
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper
[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

# Convention
[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = c_style
[sqlfluff:rules:convention.select_trailing_comma]
select_clause_trailing_comma = require
[sqlfluff:rules:convention.count_rows]
prefer_count_1 = true
[sqlfluff:rules:convention.terminator]
multiline_newline = true
require_final_semicolon = true
[sqlfluff:rules:convention.quoted_literals]
preferred_quoted_literal_style = single_quotes
[sqlfluff:rules:convention.casting_style]
preferred_type_casting_style = cast

# Layout
[sqlfluff:rules:layout.indent]
indented_using_on = true
indented_from = false
[sqlfluff:rules:layout.commas]
comma_style = trailing
# line_position = alone
[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = true
# [sqlfluff:rules:layout.newlines]
# maximum_empty_lines_inside_statements = 0
# maximum_empty_lines_between_statements = 1

# Structure
[sqlfluff:rules:structure.subquery]
forbid_subquery_in = both

##########
# Layout #
##########

[sqlfluff:layout:type:alias_expression]
spacing_before = align
align_within = select_clause
align_scope = bracketed
[sqlfluff:layout:type:select_clause]
keyword_line_position = alone
[sqlfluff:layout:type:where_clause]
keyword_line_position = alone
[sqlfluff:layout:type:orderby_clause]
keyword_line_position = alone
[sqlfluff:layout:type:groupby_clause]
keyword_line_position = alone
[sqlfluff:layout:type:having_clause]
keyword_line_position = alone
[sqlfluff:layout:type:partitionby_clause]
keyword_line_position = leading
[sqlfluff:layout:type:binary_operator]
line_position = leading
