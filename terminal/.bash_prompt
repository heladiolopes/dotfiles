PROMPT=">>"

RED="\[\033[1;31m\]"
GREEN="\[\033[1;32m\]"
YELLOW="\[\033[0;33m\]"
BLUE="\[\033[1;34m\]"
CYAN="\[\033[1;36m\]"
GRAY="\[\033[1;37m\]"
RESET="\[\033[0m\]"

get_cwd() {
    [[ $PWD == $HOME* ]] && echo "~${PWD#$HOME}" || echo "$PWD"
}

get_python_env() {
    if [ -n "$CONDA_DEFAULT_ENV" ]; then
        echo -ne "$CYAN($CONDA_DEFAULT_ENV)$RESET"
    elif [ -n "$VIRTUAL_ENV" ]; then
        name=$(basename "$VIRTUAL_ENV")
        if [[ "$name" =~ ^([a-zA-Z0-9._-]+)-[a-zA-Z0-9_-]+-(py[0-9.]+)$ ]]; then
            echo -ne "$CYAN(${BASH_REMATCH[1]}-${BASH_REMATCH[2]})$RESET"
        else
            echo -ne "$CYAN($name)$RESET"
        fi
    fi
}

get_git_branch() {
    local branch added_count mod_count untracked_count
    local added="" modified="" untracked=""

    # Nome do branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return

    # Contagens
    added_count=$(git diff --cached --name-only 2>/dev/null | wc -l)
    mod_count=$(git diff --name-only 2>/dev/null | wc -l)
    untracked_count=$(git ls-files --others --exclude-standard 2>/dev/null | wc -l)

    # Formata só se > 0
    [ "$added_count" -gt 0 ] && added="+$added_count"
    [ "$mod_count" -gt 0 ] && modified="!$mod_count"
    [ "$untracked_count" -gt 0 ] && untracked="?$untracked_count"

    # Junta tudo
    local status="$added $modified $untracked"
    status=$(echo "$status" | xargs)  # remove espaços extras

    echo -ne " ($YELLOW$branch${status:+ $status}$RESET)"
}

get_terraform_workspace() {
    if command -v terraform >/dev/null 2>&1 && [ -d ".terraform" ]; then
        ws=$(terraform workspace show 2>/dev/null)
        [ -n "$ws" ] && echo -ne "$YELLOW[tf:$ws]$RESET"
    fi
}

fill_with_dots() {
  local prefix="$*"
  local clean=$(echo -ne "$prefix" | sed 's/\x1b\[[0-9;]*m//g')
  local clean=$(echo -ne "$clean" | sed 's/\\\[//g' | sed 's/\\\]//g')

  local width=$(tput cols)
  local len=$(echo -ne "$clean" | awk '{ print length }')
  local dots=$((width - len))

  [ $dots -gt 0 ] && printf "%*s" "$dots" '' | tr ' ' '-'
}

PROMPT_COMMAND='
    context="$GREEN$(whoami)@$(hostname)$RESET"
    workdir="$BLUE$(get_cwd)$RESET"
    branch="$(get_git_branch)"

    venv="$(get_python_env)"
    tf_ws="$(get_terraform_workspace)"

    left_prompt="$context:$workdir$branch "
    right_prompt=" $venv$tf_ws"

    fill="$BLUE$(fill_with_dots "$left_prompt$right_prompt")$RESET"

    line1="$left_prompt$fill$right_prompt"
    line2="$BLUE$PROMPT$RESET"

    PS1="${line1}\n${line2} "
'
