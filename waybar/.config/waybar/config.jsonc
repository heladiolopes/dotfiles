{
  "height": 30,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "layer": "top",
  "position": "top",
  "spacing": 5,
  "reload_style_on_change": true,

  // Modules layout

  "modules-left": [
    "custom/power",
    // "custom/launcher",
    "custom/sep",
    "hyprland/workspaces"
    // "wlr/taskbar"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "idle_inhibitor",
    "bluetooth",
    "network",
    "cpu",
    "memory",
    "pulseaudio",
    "battery",
    // "power-profiles-daemon",
    "custom/notification"
  ],
  
  // Separator
  "custom/sep": {
    "format": "<span>⋮</span>",
    "tooltip": false
  },

  // Launcher
  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun",
    "on-click-right": "killall rofi"
  },

  // Idle Inhibitor
  "idle_inhibitor": {
    "format": "{icon}",
    "rotate": 0,
    "format-icons": {
      "activated": "󰥔",
      "deactivated": ""
    }
  },

  // Taskbar
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": []
  },

  // Workspaces
  "hyprland/workspaces": {
    "disable-scroll": true,
    "on-click": "activate",
    // "format": "{name}{icon}",
    "active-only": false,
    "all-outputs": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    "format-icons": {
      "active": ":  ",
      "empty": "",
      "persistent": ":  "
    }
  },

  // Clock
  "clock": {
    "format": "󰅐  {:%a %b %e %H:%M}",
    "rotate": 0,
    "format-alt": "󰅐  {:%R 󰃭 %Y·%m·%d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // Right
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "<span size='13000'>{icon} </span>{essid}",
    "format-ethernet": "<span size='13000'>󰈁 </span>{ipaddr}",
    "format-disconnected": "<span size='13000'>󰖪  </span>Disconnected",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "kitty --class Impala -e impala"
  },

  // Source Audio
  "pulseaudio": {
    "tooltip": true,
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟 Muted",
    "format-bluetooth": "{icon}  {volume}%",
    "format-bluetooth-muted": "  ",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    // "on-click": "kitty --class Wiremix -e wiremix",
    "on-click-right": "pamixer -t",
    // "on-click": "amixer sset Master toggle",
    "tooltip-format": "{desc}"
  },

  // CPU
  "cpu": {
    "format": "<span size='13000'> </span> {usage}%",
    "tooltip": false,
    "interval": 5,
    "on-click": "kitty --class Btop -e btop"
  },
 
  // Memory
  "memory": {
    "interval": 20,
    "format": "  {used}GiB",
    "max-length": 10,
    "format-alt": "  {}%",
    "tooltip": false
  },

  // Battery
  "battery": {
    "interval": 5,
    "states": { "good": 95, "warning": 30, "critical": 15 },
    "format": "<span size='13000'>{icon}</span> {capacity}%",
    "format-warning": "<span size='13000'>{icon}</span> {capacity}%",
    "format-critical": "<span size='13000'>{icon}</span> {capacity}%",
    "format-charging": "<span size='13000'></span> {capacity}%",
    "format-plugged": "<span size='13000'></span> {capacity}%",
    // "format-icons": [" ", " ", " ", " ", " "],
    "format-icons": {
      "charging": [
        "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"
      ],
      "default": [
        "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
      ]
    },
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
  },
  
  // Logout Power Menu
  "custom/power": {
    "format" : "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  },

  // Notification center
  "custom/notification": {
    "tooltip": false,
    "justify": "center",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚<span foreground='red'><sup></sup></span>",
      "none": "󰂚",
      "dnd-notification": "󰂛<span foreground='red'><sup></sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='red'><sup></sup></span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },

  // Sys tray
  "tray": {
    "icon-size": 18,
    "show-passive-items": true,
    "spacing": 10,
    "reverse-direction": true
  },

  // Bluetooth
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueberry"
  },

  // Power Profile
  "power-profiles-daemon": {
    "format": "{icon}   {profile}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

}
