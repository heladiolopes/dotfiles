{
  //
  // Base configuration
  //
  "height": 30,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "layer": "top",
  "position": "top",
  "spacing": 5,
  "reload_style_on_change": true,
  //
  // Modules layout
  //
  "modules-left": [
    "custom/power",
    // "custom/sep",
    // "custom/launcher",
    "custom/sep",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/idle_inhibitor",
    "bluetooth",
    "network",
    "cpu",
    "memory",
    "pulseaudio",
    "battery",
    "power-profiles-daemon",
    "custom/notification"
  ],
  //
  // Power Buttom
  //
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  },
  //
  // Separator
  //
  "custom/sep": {
    "format": "<span>⋮</span>",
    "tooltip": false
  },
  //
  // Launcher
  //
  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun",
    "on-click-right": "killall rofi"
  },
  //
  // Workspaces
  //
  "hyprland/workspaces": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": true,
    "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] },
    "format": "{name}{windows}",
    "format-window-separator": " ",
    "window-rewrite-default": " 󰘔",
    "window-rewrite": {
      "class<.*[Kk]itty.*>": " ",
      "class<.*[Kk]itty.*> title<.*tmux.*>": " ",
      "class<.*[Ff]irefox.*>": " ",
      "class<.*([Cc]ode|[Cc]odium).*>": " 󰨞",
      "class<.*([Oo]bsidian).*>": " ",
      "class<.*[Qq]view.*>": " ",
      "class<.*[Ss]team.*>": " ",
      "class<.*[Dd]olphin.*>": " "
    }
  },
  //
  // Window
  //
  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": true
    // "rewrite": {
    //   "(.*) — Mozilla Firefox": "$1",
    //   "(.*) - Visual Studio Code": "$1"
    // }
  },
  //
  // Clock
  //
  "clock": {
    "format": "󰃭  {:%a %b %e 󰅐 %H:%M}",
    "format-alt": "󰃭  {:%Y·%m·%d 󰅐 %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  //
  // System tray
  //
  "tray": {
    "icon-size": 18,
    "show-passive-items": true,
    "spacing": 10,
    "reverse-direction": true,
    "orders": {
		  "wechat": 99
	  }
  },
  //
  // Idle Inhibitor
  //
  "custom/idle_inhibitor": {
    "exec": "idle-inhibitor status",
    "on-click": "idle-inhibitor toggle",
    "exec-on-event": false,
    "return-type": "json",
    "signal": 8,
    "format": "{icon}",
    "format-icons": { "activated": "󰥔", "deactivated": "" }
  },
  //
  // Bluetooth Manager
  //
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": ": {num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },
  //
  // Network Manager
  //
  "network": {
    "interval": 3,
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈁 {ipaddr}",
    "format-disconnected": "󰖪  Disconnected",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    // "on-click": "kitty --class Impala -e impala"
    "on-click": "nm-connection-editor"
  },
  //
  // CPU Monitor
  //
  "cpu": {
    "interval": 5,
    "format": "  {usage}%",
    "on-click": "kitty --class Btop -e btop"
  },
  //
  // Memory Monitor
  //
  "memory": {
    "interval": 10,
    "format": "  {used:0.1f}G",
    "format-alt": "  {}%"
  },
  //
  // Audio Manager
  //
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-bluetooth": "{icon}  {volume}%",
    // "format-bluetooth-muted":,
    "format-icons": { "headphone": "", "default": ["", "", ""] },
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t"
  },
  //
  // Baterry Monitor
  //
  "battery": {
    "interval": 10,
    "states": { "good": 95, "warning": 30, "critical": 15 },
    "format": "{icon}  {capacity}%",
    "format-warning": "{icon}  {capacity}%",
    "format-critical": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": {
      // "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      // "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
      "charging": ["󱐋 ", "󱐋 ", "󱐋 ", "󱐋 ", "󱐋 "],
      "default": ["", "", "", "", ""]
    },
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%"
  },
  //
  // Power Profile Daemon
  //
  // Power Profile
  "power-profiles-daemon": {
    "format": "{icon} ",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  //
  // Notification central
  //
  "custom/notification": {
    "justify": "center",
    "format": "{icon}",
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true,
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛"
    }
  }
}

